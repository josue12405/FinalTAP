<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.proyectofinaltap.controller.ReservacionesController"
      style="-fx-background-color: #f4f6f9;">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <!-- Encabezado -->
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Label text="Gestión de Reservaciones" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="22.0"/>
            </font>
        </Label>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblUsuarioActivo" text="Usuario: -" textFill="#5d6d7e">
            <font>
                <Font name="System Bold" size="13.0"/>
            </font>
        </Label>
    </HBox>

    <!-- Formulario de Nueva Reservación -->
    <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 2);">
        <padding>
            <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
        </padding>

        <Label text="Nueva Reservación" textFill="#34495e">
            <font>
                <Font name="System Bold" size="15.0"/>
            </font>
        </Label>

        <GridPane hgap="15.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="33.3"/>
                <ColumnConstraints percentWidth="33.3"/>
                <ColumnConstraints percentWidth="33.3"/>
            </columnConstraints>

            <!-- Fila 1 -->
            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Huésped:"/>
                <ComboBox fx:id="cmbHuesped" promptText="Seleccione huésped..." maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Habitación:"/>
                <ComboBox fx:id="cmbHabitacion" promptText="Seleccione habitación..." maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Label text="Resumen de Costo:"/>
                <Label fx:id="lblTotalEstimado" text="0 noches | Total: $0.00" textFill="#1e8449">
                    <font>
                        <Font name="System Bold" size="14.0"/>
                    </font>
                </Label>
            </VBox>

            <!-- Fila 2 -->
            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label text="Fecha de Entrada:"/>
                <DatePicker fx:id="dpFechaEntrada" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label text="Fecha de Salida:"/>
                <DatePicker fx:id="dpFechaSalida" maxWidth="Infinity"/>
            </VBox>

            <HBox alignment="BOTTOM_RIGHT" spacing="10.0" GridPane.columnIndex="2" GridPane.rowIndex="1">
                <Button text="Limpiar" onAction="#limpiarFormulario"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="Registrar Reservación" onAction="#registrarReservacion"
                        style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>
        </GridPane>
    </VBox>

    <!-- Tabla y Acciones de Estado -->
    <VBox spacing="10.0" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 2);">
        <padding>
            <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Historial y Control de Estancias" textFill="#34495e">
                <font>
                    <Font name="System Bold" size="15.0"/>
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Hacer Check-In" onAction="#hacerCheckIn"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button text="Hacer Check-Out" onAction="#hacerCheckOut"
                    style="-fx-background-color: #d35400; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button text="Cancelar Reserva" onAction="#cancelarReservacion"
                    style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>

        <TableView fx:id="tblReservaciones" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50.0"/>
                <TableColumn fx:id="colHuesped" text="Huésped" prefWidth="180.0"/>
                <TableColumn fx:id="colHabitacion" text="Habitación" prefWidth="95.0"/>
                <TableColumn fx:id="colEntrada" text="Entrada" prefWidth="105.0"/>
                <TableColumn fx:id="colSalida" text="Salida" prefWidth="105.0"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="110.0"/>
                <TableColumn fx:id="colTotal" text="Total ($)" prefWidth="100.0"/>
                <TableColumn fx:id="colUsuario" text="Registró" prefWidth="150.0"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>