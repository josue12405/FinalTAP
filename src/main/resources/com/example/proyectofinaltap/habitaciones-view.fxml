<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.proyectofinaltap.controller.HabitacionesController">

    <!-- Fila 1: Campos de captura -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <TextField fx:id="txtNumero" prefWidth="130.0" promptText="Núm. (Ej. 103)"
                   style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-padding: 6 10;" />
        <ComboBox fx:id="cmbTipo" prefWidth="140.0" promptText="Tipo"
                  style="-fx-background-radius: 6;" />
        <TextField fx:id="txtPrecio" prefWidth="130.0" promptText="Precio/Noche"
                   style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-padding: 6 10;" />
        <ComboBox fx:id="cmbEstado" prefWidth="150.0" promptText="Estado"
                  style="-fx-background-radius: 6;" />
    </HBox>

    <!-- Fila 2: Botones de acción -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button onAction="#guardarHabitacion"
                style="-fx-background-color: #1e3a8a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 7 16;"
                text="Guardar" />
        <Button onAction="#actualizarHabitacion"
                style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 7 16;"
                text="Actualizar" />
        <Button onAction="#limpiarFormulario"
                style="-fx-background-color: #e2e8f0; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 7 16;"
                text="Limpiar" />
    </HBox>

    <!-- Tabla de Habitaciones -->
    <TableView fx:id="tablaHabitaciones" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
            <TableColumn fx:id="colNumero" prefWidth="120.0" text="Número" />
            <TableColumn fx:id="colTipo" prefWidth="150.0" text="Tipo" />
            <TableColumn fx:id="colPrecio" prefWidth="140.0" text="Precio / Noche" />
            <TableColumn fx:id="colEstado" prefWidth="160.0" text="Estado" />
        </columns>
    </TableView>

    <!-- Barra inferior -->
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Button onAction="#eliminarHabitacion"
                style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 7 14;"
                text="Eliminar Seleccionada" />
        <Label fx:id="lblEstado" text="Selecciona una fila para editar o eliminar." textFill="#475569" />
    </HBox>
</VBox>