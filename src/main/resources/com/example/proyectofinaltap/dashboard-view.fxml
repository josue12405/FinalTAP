<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="620.0" prefWidth="950.0"
            style="-fx-background-color: #f1f5f9;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyectofinaltap.controller.DashboardController">

    <!-- Menú Lateral (Sidebar) -->
    <left>
        <VBox prefWidth="230.0" spacing="10.0"
              style="-fx-background-color: #0f172a;">
            <padding>
                <Insets bottom="25.0" left="20.0" right="20.0" top="25.0" />
            </padding>

            <Label text="GRAND HORIZON" textFill="#fbbf24">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Label>

            <Label text="Panel de Control" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>

            <Separator opacity="0.2">
                <VBox.margin>
                    <Insets bottom="10.0" top="5.0" />
                </VBox.margin>
            </Separator>

            <Button fx:id="btnHabitaciones" alignment="CENTER_LEFT" maxWidth="Infinity"
                    onAction="#mostrarHabitaciones" prefHeight="40.0"
                    style="-fx-background-color: #1e3a8a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 0 15 0 15;"
                    text="🛏  Habitaciones" />

            <Button fx:id="btnHuespedes" alignment="CENTER_LEFT" maxWidth="Infinity"
                    onAction="#mostrarHuespedes" prefHeight="40.0"
                    style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 0 15 0 15;"
                    text="👤  Huéspedes" />

            <Button fx:id="btnReservaciones" alignment="CENTER_LEFT" maxWidth="Infinity"
                    onAction="#mostrarReservaciones" prefHeight="40.0"
                    style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 0 15 0 15;"
                    text="📅  Reservaciones" />

            <Region VBox.vgrow="ALWAYS" />

            <Separator opacity="0.2" />

            <Button alignment="CENTER_LEFT" maxWidth="Infinity"
                    onAction="#cerrarSesion" prefHeight="38.0"
                    style="-fx-background-color: #991b1b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 0 15 0 15;"
                    text="🚪  Cerrar Sesión" />
        </VBox>
    </left>

    <!-- Área Principal -->
    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>

            <!-- Barra Superior -->
            <HBox alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15 20 15 20;">
                <Label fx:id="lblTituloSeccion" text="Gestión de Habitaciones" textFill="#0f172a">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblUsuarioActivo" text="Sesión activa" textFill="#64748b">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Label>
            </HBox>

            <!-- Contenedor Dinámico de Módulos -->
            <StackPane fx:id="contenedorCentral"
                       style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;"
                       VBox.vgrow="ALWAYS">
                <Label fx:id="lblPlaceholder" text="Módulo listo para conectar su tabla y formulario." textFill="#64748b" />
            </StackPane>
        </VBox>
    </center>
</BorderPane>